<div class="border border-[#1e3a5f] rounded-2xl p-4 md:p-6 bg-[#152a48] shadow-xl"
     data-controller="hunt-map"
     data-hunt-map-pins-value="<%= pins.to_json %>"
     data-hunt-map-recap-value="<%= recap %>"
     data-hunt-map-interactive-value="false"
     data-hunt-map-map-path-value="<%= map_path(season_id: season.year) %>"
     data-hunt-map-new-entry-path-value="<%= new_tree_entry_path %>">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg md:text-xl font-bold text-[#f4efe4] flex items-center gap-2">
      <span>🗺️</span> <%= recap ? "Season recap" : "Where the trees are" %>
    </h2>
    <%= link_to "Open map →", map_path(season_id: season.year), class: "text-xs font-semibold text-[#c4a35a] hover:text-[#e0c57a]" %>
  </div>
  <div data-hunt-map-target="canvas" class="h-72 rounded-xl overflow-hidden border border-[#1e3a5f]"></div>
  <p class="text-[11px] text-[#7a8ea8] mt-3">Tap a pin or open the map to plan the next run.</p>
</div>
