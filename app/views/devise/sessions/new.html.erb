<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-6">
    <!-- Header -->
    <div class="text-center">
      <div class="inline-block text-[11px] font-bold tracking-[2.5px] uppercase text-[#c4a35a] mb-2">
        A SPARE PAIR OF PROJECTS
      </div>
      <h1 class="text-3xl font-extrabold text-[#f4efe4] tracking-tight flex items-center justify-center gap-2 mb-1">
        <span>🎄</span> <span>Mid-Winter Tree Tracker</span>
      </h1>
      <p class="text-sm text-[#9eb4d4]">Sign in to track your tree collection</p>
    </div>

    <!-- Card Container -->
    <div class="bg-[#152a48] border border-[#1e3a5f] rounded-2xl shadow-2xl p-6 md:p-8 space-y-6">
      <!-- Google OAuth Button -->
      <%= link_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "w-full flex items-center justify-center px-4 py-3 border border-[#1e3a5f] rounded-xl shadow bg-white hover:bg-gray-100 transition-all text-sm font-semibold text-gray-800" do %>
        <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span>Continue with Google</span>
      <% end %>

      <!-- Divider -->
      <div class="relative my-4">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-[#1e3a5f]"></div>
        </div>
        <div class="relative flex justify-center text-xs">
          <span class="px-3 bg-[#152a48] text-[#9eb4d4]">or continue with email</span>
        </div>
      </div>

      <!-- Email/Password Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email, class: "block text-xs font-bold text-[#c9bda4] uppercase tracking-wider mb-2" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-4 py-2.5 border border-[#1e3a5f] rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-[#c4a35a] bg-[#0f1c2e] text-[#f4efe4] placeholder-[#7a8ea8] text-sm" %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <%= f.label :password, class: "block text-xs font-bold text-[#c9bda4] uppercase tracking-wider" %>
              <% if devise_mapping.recoverable? %>
                <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs text-[#c4a35a] hover:text-[#e0c57a] transition-colors" %>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "w-full px-4 py-2.5 border border-[#1e3a5f] rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-[#c4a35a] bg-[#0f1c2e] text-[#f4efe4] placeholder-[#7a8ea8] text-sm" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-[#16a34a] focus:ring-[#c4a35a] border-[#1e3a5f] rounded bg-[#0f1c2e] cursor-pointer" %>
            <%= f.label :remember_me, class: "ml-2 block text-xs text-[#9eb4d4] cursor-pointer" %>
          </div>
        <% end %>

        <div class="pt-2">
          <%= f.submit "Log In", class: "w-full flex justify-center items-center py-3 px-4 rounded-xl shadow-md text-base font-bold text-white bg-[#16a34a] hover:bg-[#15803d] transition-all cursor-pointer" %>
        </div>
      <% end %>

      <!-- Sign Up Link -->
      <div class="text-center pt-4 border-t border-[#1e3a5f]">
        <p class="text-xs text-[#9eb4d4]">
          Don't have an account?
          <%= link_to "Sign up", new_registration_path(resource_name), class: "font-bold text-[#c4a35a] hover:text-[#e0c57a] transition-colors ml-1" %>
        </p>
      </div>
    </div>
  </div>
</div>
