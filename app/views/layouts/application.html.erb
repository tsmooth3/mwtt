<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0f1c2e]">
  <head>
    <title><%= content_for(:title) || "MWTT · extrapants" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%# Prevent caching in development to ensure CSS updates are visible %>
    <% if Rails.env.development? %>
      <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
      <meta http-equiv="Pragma" content="no-cache">
      <meta http-equiv="Expires" content="0">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      /* extrapants brand foundation */
      html, body {
        background-color: #0f1c2e !important;
        color: #f4efe4 !important;
      }
      
      /* Flash message animations */
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
      }
    </style>
    <%= javascript_importmap_tags %>
    
    <%# Google Charts - load first %>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script>
      // Load Google Charts
      google.charts.load('current', {'packages':['corechart']});
    </script>
    <%# Load Chartkick directly to avoid preload warnings %>
    <script src="<%= asset_path('chartkick.js') %>"></script>
    <script>
      // Configure Chartkick to use Google Charts after both are loaded
      function configureChartkick() {
        if (typeof Chartkick !== 'undefined' && typeof google !== 'undefined') {
          Chartkick.configure({adapter: 'googleCharts'});
          
          // Ensure Google Charts is ready
          google.charts.setOnLoadCallback(function() {
            console.log('Google Charts ready, charts should render');
          });
        } else {
          setTimeout(configureChartkick, 50);
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', configureChartkick);
      } else {
        configureChartkick();
      }
      
      document.addEventListener('turbo:load', configureChartkick);
    </script>
  </head>

  <body class="min-h-full flex flex-col bg-[#0f1c2e] text-[#f4efe4] antialiased" style="background-color: #0f1c2e !important; color: #f4efe4 !important;">
    <%# Navigation Bar %>
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[#0f1c2e]/95 backdrop-blur border-b border-[#1e3a5f] shadow-lg" data-controller="mobile-menu">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex items-center justify-between h-16">
          <%# Brand Logo & Lockup %>
          <%= link_to root_path, class: "flex items-center gap-2 group transition-opacity hover:opacity-90" do %>
            <span class="text-xl">🎄</span>
            <span class="text-lg font-bold tracking-tight">
              <span class="font-normal text-[#9eb4d4]">mid-winter</span> <span class="font-extrabold text-[#f4efe4]">tree tracker</span>
            </span>
          <% end %>

          <%# Desktop Nav %>
          <% if user_signed_in? %>
            <div class="hidden md:flex items-center space-x-6">
              <%= link_to "Entries", tree_entries_path, class: "text-sm font-medium text-[#c9bda4] hover:text-[#e0c57a] transition-colors" %>
              <%= link_to "Families", families_path, class: "text-sm font-medium text-[#c9bda4] hover:text-[#e0c57a] transition-colors" %>
              <span class="text-xs text-[#9eb4d4] truncate max-w-[160px] bg-[#152a48] border border-[#1e3a5f] px-2.5 py-1 rounded-full"><%= current_user.email %></span>
              <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-3 py-1.5 text-xs font-semibold text-[#f4efe4] bg-[#152a48] hover:bg-[#b54a3a]/80 border border-[#1e3a5f] hover:border-[#b54a3a] rounded-md transition-all" %>
            </div>
          <% else %>
            <div class="hidden md:flex items-center space-x-6">
              <%= link_to "Entries", tree_entries_path, class: "text-sm font-medium text-[#c9bda4] hover:text-[#e0c57a] transition-colors" %>
              <%= link_to "Families", families_path, class: "text-sm font-medium text-[#c9bda4] hover:text-[#e0c57a] transition-colors" %>
              <div class="flex items-center space-x-3">
                <%= link_to "Login", new_user_session_path, class: "px-3.5 py-1.5 text-sm font-medium text-[#f4efe4] hover:text-[#e0c57a] transition-colors" %>
                <%= link_to "Sign Up", new_user_registration_path, class: "px-3.5 py-1.5 text-sm font-semibold text-white bg-[#16a34a] hover:bg-[#15803d] rounded-md shadow transition-colors" %>
              </div>
            </div>
          <% end %>

          <%# Mobile menu toggle button %>
          <div class="md:hidden flex items-center">
            <button type="button" 
                    data-action="click->mobile-menu#toggle" 
                    class="inline-flex items-center justify-center p-2 rounded-lg text-[#c9bda4] hover:text-[#f4efe4] hover:bg-[#152a48] focus:outline-none focus:ring-2 focus:ring-[#c4a35a]" 
                    aria-expanded="false" 
                    aria-label="Toggle navigation">
              <%# Hamburger icon %>
              <svg data-mobile-menu-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
              <%# Close icon %>
              <svg data-mobile-menu-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <%# Mobile Dropdown Menu %>
        <div data-mobile-menu-target="menu" class="hidden md:hidden border-t border-[#1e3a5f] py-3 space-y-2 bg-[#0f1c2e]/98">
          <% if user_signed_in? %>
            <div class="px-3 py-2 bg-[#152a48] border border-[#1e3a5f] rounded-lg text-xs text-[#9eb4d4] truncate">
              Signed in as <span class="font-medium text-[#e0c57a]"><%= current_user.email %></span>
            </div>
            <%= link_to root_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium text-[#f4efe4] hover:bg-[#152a48] hover:text-[#e0c57a] transition-colors", data: { action: "click->mobile-menu#close" } do %>
              <span>🏠 Dashboard</span>
            <% end %>
            <%= link_to tree_entries_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium text-[#f4efe4] hover:bg-[#152a48] hover:text-[#e0c57a] transition-colors", data: { action: "click->mobile-menu#close" } do %>
              <span>📋 Entries</span>
            <% end %>
            <%= link_to families_path, class: "flex items-center px-3 py-2 rounded-lg text-sm font-medium text-[#f4efe4] hover:bg-[#152a48] hover:text-[#e0c57a] transition-colors", data: { action: "click->mobile-menu#close" } do %>
              <span>👨‍👩‍👧‍👦 Families</span>
            <% end %>
            <div class="pt-2 border-t border-[#1e3a5f]">
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete, action: "click->mobile-menu#close" }, class: "w-full flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-[#b54a3a] hover:bg-[#9e3a2b] rounded-lg transition-colors shadow" do %>
                <span>🚪 Logout</span>
              <% end %>
            </div>
          <% else %>
            <%= link_to "Entries", tree_entries_path, class: "block px-3 py-2 rounded-lg text-sm font-medium text-[#f4efe4] hover:bg-[#152a48] hover:text-[#e0c57a]", data: { action: "click->mobile-menu#close" } %>
            <%= link_to "Families", families_path, class: "block px-3 py-2 rounded-lg text-sm font-medium text-[#f4efe4] hover:bg-[#152a48] hover:text-[#e0c57a]", data: { action: "click->mobile-menu#close" } %>
            <div class="pt-2 border-t border-[#1e3a5f] flex flex-col space-y-2">
              <%= link_to "Login", new_user_session_path, class: "w-full text-center px-4 py-2 text-sm font-medium text-[#f4efe4] bg-[#152a48] hover:bg-[#1c365d] border border-[#1e3a5f] rounded-lg transition-colors", data: { action: "click->mobile-menu#close" } %>
              <%= link_to "Sign Up", new_user_registration_path, class: "w-full text-center px-4 py-2 text-sm font-semibold text-white bg-[#16a34a] hover:bg-[#15803d] rounded-lg shadow transition-colors", data: { action: "click->mobile-menu#close" } %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <%# Main Content Area %>
    <div class="pt-20 flex-1 flex flex-col">
      <%# Flash Messages %>
      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <% 
          case type.to_s
          when 'notice', 'success'
            bg_style = 'background-color: #152a48; border-color: #16a34a; color: #f4efe4;'
            icon_color = '#4ade80'
            icon_path = 'M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
          when 'alert', 'error', 'danger'
            bg_style = 'background-color: #152a48; border-color: #b54a3a; color: #f4efe4;'
            icon_color = '#f87171'
            icon_path = 'M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z'
          else
            bg_style = 'background-color: #152a48; border-color: #c4a35a; color: #f4efe4;'
            icon_color = '#e0c57a'
            icon_path = 'M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z'
          end
        %>
        <div class="container mx-auto px-4 max-w-5xl mt-3 animate-fade-in">
          <div class="border-2 px-4 py-3 rounded-lg shadow-lg relative flex items-center space-x-3 text-sm" role="alert" style="<%= bg_style %>">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: <%= icon_color %>;">
              <path fill-rule="evenodd" d="<%= icon_path %>" clip-rule="evenodd"/>
            </svg>
            <span class="flex-1 font-medium"><%= message %></span>
          </div>
        </div>
      <% end %>

      <main class="container mx-auto px-4 py-6 md:py-8 max-w-5xl flex-1">
        <%= yield %>
      </main>
    </div>

    <%# Footer %>
    <footer class="mt-auto border-t border-[#1e3a5f] bg-[#0b1420] py-8 text-[#9eb4d4]">
      <div class="container mx-auto px-4 max-w-5xl flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold tracking-tight text-[#f4efe4]">
            <span class="font-medium text-[#9eb4d4]">extra</span><span class="font-extrabold text-[#f4efe4]">pants</span>
          </span>
          <span class="text-[#7a6a4a]">·</span>
          <span class="text-[#c4a35a] font-medium">🎄 Mid-Winter Tree Tracker</span>
        </div>
        <div class="text-center sm:text-right text-[#7a8ea8]">
          <p>© <%= Date.current.year %> <strong class="font-semibold text-[#c9bda4]">extrapants</strong> · a spare pair of projects</p>
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener('turbo:load', function() {
        setTimeout(function() {
          if (typeof Chartkick !== 'undefined' && typeof google !== 'undefined') {
            var chartElements = document.querySelectorAll('[data-chartkick]');
            chartElements.forEach(function(el) {});
          }
        }, 100);
      });
    </script>
  </body>
</html>
