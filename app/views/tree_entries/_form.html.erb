<%= form_with model: tree_entry, local: true, class: "space-y-4", data: { controller: "pin-picker", pin_picker_nearby_url_value: nearby_locations_path } do |f| %>
  <% if tree_entry.errors.any? %>
    <div class="bg-[#b54a3a]/20 border border-[#b54a3a] text-[#f4efe4] px-4 py-3 rounded-xl text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% tree_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :family_id, "Family", class: "block text-xs font-bold text-[#c9bda4] uppercase tracking-wider mb-2" %>
    <%= f.collection_select :family_id, families, :id, :name,
        { include_blank: "None — scout / empty check", selected: tree_entry.family_id || current_family&.id },
        { class: "w-full px-4 py-2.5 border border-[#1e3a5f] rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-[#c4a35a] bg-[#0f1c2e] text-[#f4efe4] text-sm" } %>
    <p class="text-[11px] text-[#7a8ea8] mt-1">Required only when you collected trees.</p>
  </div>

  <div>
    <%= f.label :entry_date, "Date", class: "block text-xs font-bold text-[#c9bda4] uppercase tracking-wider mb-2" %>
    <%= f.date_field :entry_date, class: "w-full px-4 py-2.5 border border-[#1e3a5f] rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-[#c4a35a] bg-[#0f1c2e] text-[#f4efe4] text-sm" %>
    <p class="text-[11px] text-[#7a8ea8] mt-1">Dates from Dec 1–Feb 15 belong to that Christmas. Other dates count toward the upcoming hunt so you can test off-season.</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :seen, "Seen", class: "block text-xs font-bold text-[#c9bda4] uppercase tracking-wider mb-2" %>
      <%= f.number_field :seen, min: 0, step: 1, placeholder: "optional", class: "w-full px-4 py-2.5 border border-[#1e3a5f] rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-[#c4a35a] bg-[#0f1c2e] text-[#f4efe4] text-sm" %>
    </div>
    <div>
      <%= f.label :collected, "Collected", class: "block text-xs font-bold text-[#c9bda4] uppercase tracking-wider mb-2" %>
      <%= f.number_field :collected, min: 0, step: 1, placeholder: "0", class: "w-full px-4 py-2.5 border border-[#1e3a5f] rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-[#c4a35a] bg-[#0f1c2e] text-[#f4efe4] text-sm" %>
    </div>
  </div>
  <p class="text-[11px] text-[#7a8ea8] -mt-2">Seen is what was there. Collected counts toward the bonfire. Leave seen blank if you didn't count what was left.</p>

  <div class="border border-[#1e3a5f] rounded-xl p-4 bg-[#0f1c2e] space-y-3">
    <div class="flex items-center justify-between gap-2">
      <div>
        <p class="text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Location</p>
        <p class="text-[11px] text-[#7a8ea8]">Optional for a collection. Required to report what you saw.</p>
      </div>
      <button type="button" data-action="pin-picker#useGps" class="px-3 py-1.5 text-xs font-semibold text-[#f4efe4] bg-[#1e3a5f] hover:bg-[#2c5282] rounded-lg">
        Use my location
      </button>
    </div>

    <%= f.hidden_field :location_id, data: { pin_picker_target: "locationId" } %>
    <%= f.hidden_field :latitude, value: tree_entry.location&.latitude || @prefill_lat, data: { pin_picker_target: "latitude" } %>
    <%= f.hidden_field :longitude, value: tree_entry.location&.longitude || @prefill_lng, data: { pin_picker_target: "longitude" } %>

    <div>
      <%= f.label :location_name, "Pin name (optional)", class: "block text-[11px] font-bold text-[#c9bda4] uppercase tracking-wider mb-1" %>
      <%= f.text_field :location_name, value: tree_entry.location&.name, placeholder: "Pasadena east", class: "w-full px-3 py-2 border border-[#1e3a5f] rounded-lg bg-[#152a48] text-[#f4efe4] text-sm", data: { pin_picker_target: "locationName" } %>
    </div>

    <div data-pin-picker-target="map" class="h-56 rounded-lg overflow-hidden border border-[#1e3a5f]"></div>
    <p data-pin-picker-target="status" class="text-[11px] text-[#9eb4d4]">
      <% if tree_entry.location %>
        Using <%= tree_entry.location.display_name %>.
      <% else %>
        Tap the map to drop a pin, or leave it blank.
      <% end %>
    </p>
    <div data-pin-picker-target="nearby" class="space-y-2"></div>
    <button type="button" data-action="pin-picker#clear" class="text-[11px] text-[#c4a35a] hover:text-[#e0c57a]">Clear pin</button>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 pt-2">
    <%= f.submit submit_label, class: "px-5 py-2.5 bg-[#16a34a] hover:bg-[#15803d] text-white rounded-xl font-bold shadow transition-colors cursor-pointer text-sm" %>
    <%= link_to "Cancel", cancel_path, class: "px-5 py-2.5 border border-[#1e3a5f] hover:bg-[#0f1c2e] rounded-xl text-center text-[#c9bda4] text-sm font-medium transition-colors" %>
  </div>
<% end %>
