    <h1 class="text-2xl font-extrabold text-[#f4efe4] tracking-tight flex items-center gap-2">
      <span>✏️</span> <span>Edit Entry</span>
    </h1>
  </div>

  <div class="border border-[#1e3a5f] rounded-2xl p-6 bg-[#152a48] shadow-xl">
    <%= render "form", tree_entry: @tree_entry, families: @families, submit_label: "Update Entry", cancel_path: tree_entry_path(@tree_entry) %>
  </div>
</div>
