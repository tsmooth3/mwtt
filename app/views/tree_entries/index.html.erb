<div class="w-full space-y-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="text-[11px] font-bold tracking-[2px] uppercase text-[#c4a35a]">FIELD REPORTS</div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-[#f4efe4] tracking-tight flex items-center gap-2">
        <span>🎄</span> <span>Entries</span>
      </h1>
    </div>
    <%= link_to new_tree_entry_path, class: "px-4 py-2.5 bg-[#16a34a] hover:bg-[#15803d] text-white rounded-xl font-bold shadow-md hover:shadow-lg transition-all flex items-center gap-2 text-sm" do %>
      <span>+</span> <span>Log New Entry</span>
    <% end %>
  </div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-[#152a48]/70 border border-[#1e3a5f] p-3.5 rounded-xl">
    <label class="text-sm font-semibold text-[#c9bda4]">Season:</label>
    <%= form_with url: tree_entries_path, method: :get, local: true, class: "w-full sm:w-auto" do %>
      <%= hidden_field_tag :filter, @filter %>
      <%= select_tag :season_id,
          options_from_collection_for_select(@all_seasons, :year, :year, @current_season.year),
          { onchange: "this.form.submit()", class: "w-full sm:w-48 px-3.5 py-1.5 border border-[#1e3a5f] rounded-lg bg-[#0f1c2e] text-[#f4efe4] text-sm" } %>
    <% end %>
  </div>

  <% if @is_family_admin %>
    <div class="p-4 bg-[#152a48] border border-[#2c5282] rounded-xl text-sm text-[#9eb4d4]">
      👑 <strong class="text-[#f4efe4]">Admin View:</strong> Showing entries across all families for the <%= @current_season.year %> season.
    </div>
  <% elsif current_family %>
    <div class="p-4 bg-[#152a48] border border-[#16a34a]/40 rounded-xl text-sm text-[#9eb4d4]">
      🌲 <strong class="text-[#4ade80]"><%= current_family.name %> Family:</strong> Showing entries for your family.
    </div>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Collections", tree_entries_path(filter: "collections", season_id: @current_season.year), class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{@filter == 'collections' ? 'bg-[#16a34a] text-white' : 'bg-[#152a48] border border-[#1e3a5f] text-[#c9bda4]'}" %>
    <%= link_to "Scouting", tree_entries_path(filter: "scouting", season_id: @current_season.year), class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{@filter == 'scouting' ? 'bg-[#16a34a] text-white' : 'bg-[#152a48] border border-[#1e3a5f] text-[#c9bda4]'}" %>
    <%= link_to "All", tree_entries_path(filter: "all", season_id: @current_season.year), class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{@filter == 'all' ? 'bg-[#16a34a] text-white' : 'bg-[#152a48] border border-[#1e3a5f] text-[#c9bda4]'}" %>
  </div>

  <% if @tree_entries.any? %>
    <div class="block sm:hidden space-y-3">
      <% @tree_entries.each do |entry| %>
        <div class="border rounded-xl p-4 bg-[#152a48] shadow-md <%= entry.user == current_user ? 'border-[#16a34a]/60' : 'border-[#1e3a5f]' %>">
          <div class="flex justify-between items-start mb-3">
            <div>
              <p class="text-sm font-bold text-[#f4efe4]"><%= entry.entry_date.strftime("%b %d, %Y") %></p>
              <p class="text-xs text-[#9eb4d4] mt-0.5">Season <%= entry.season.year %> · <%= entry_kind_label(entry, filter: @filter) %></p>
              <% if entry.family %>
                <p class="text-xs text-[#c4a35a] font-medium mt-1"><%= entry.family.name %></p>
              <% end %>
              <% if entry.location %>
                <p class="text-xs text-[#9eb4d4] mt-1">📍 <%= entry.location.display_name %></p>
              <% end %>
            </div>
            <div class="text-right">
              <span class="text-xl font-extrabold text-[#4ade80]"><%= entry_primary_count(entry, filter: @filter) %></span>
              <p class="text-[11px] text-[#9eb4d4]"><%= entry_primary_unit(entry, filter: @filter) %></p>
              <% if @filter != "scouting" && entry.seen.present? %>
                <p class="text-[11px] text-[#c4a35a]"><%= entry.seen %> seen</p>
              <% elsif @filter == "scouting" && entry.leftover? %>
                <p class="text-[11px] text-[#c4a35a]"><%= entry.collected %> already collected</p>
              <% end %>
            </div>
          </div>
          <% if @is_family_admin || entry.user == current_user %>
            <div class="pt-3 border-t border-[#1e3a5f] flex gap-2">
              <%= link_to "Edit", edit_tree_entry_path(entry), class: "flex-1 px-3 py-1.5 text-center bg-[#1e3a5f] hover:bg-[#2c5282] text-[#f4efe4] rounded-lg transition-colors text-xs font-semibold" %>
              <%= link_to "Delete", tree_entry_path(entry),
                  data: { turbo_method: :delete, turbo_confirm: "Delete this entry?" },
                  class: "flex-1 px-3 py-1.5 text-center bg-[#b54a3a]/80 hover:bg-[#b54a3a] text-white rounded-lg transition-colors text-xs font-semibold" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="hidden sm:block border border-[#1e3a5f] rounded-2xl overflow-hidden bg-[#152a48] shadow-xl">
      <table class="min-w-full divide-y divide-[#1e3a5f]">
        <thead class="bg-[#0f1c2e]">
          <tr>
            <th class="px-6 py-3.5 text-left text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Date</th>
            <th class="px-6 py-3.5 text-left text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Report</th>
            <th class="px-6 py-3.5 text-left text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Season</th>
            <th class="px-6 py-3.5 text-left text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Place</th>
            <th class="px-6 py-3.5 text-left text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Family</th>
            <th class="px-6 py-3.5 text-right text-xs font-bold text-[#c9bda4] uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1e3a5f] bg-[#152a48]">
          <% @tree_entries.each do |entry| %>
            <tr class="hover:bg-[#1c365d]/50 transition-colors <%= 'bg-[#16a34a]/10' if entry.user == current_user %>">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-[#f4efe4]">
                <%= entry.entry_date.strftime("%b %d, %Y") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-[#4ade80] font-bold">
                <%= entry_summary(entry, filter: @filter) %>
                <span class="block text-[11px] font-medium text-[#9eb4d4]"><%= entry_kind_label(entry, filter: @filter) %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-[#9eb4d4]">
                <%= entry.season.year %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-[#c9bda4]">
                <%= entry.location&.display_name || "—" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-[#c4a35a] font-medium">
                <%= entry.family&.name || "—" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <% if @is_family_admin || entry.user == current_user %>
                  <div class="flex justify-end gap-2">
                    <%= link_to "Edit", edit_tree_entry_path(entry), class: "px-3 py-1 bg-[#1e3a5f] hover:bg-[#2c5282] text-[#f4efe4] rounded-lg transition-colors text-xs font-semibold" %>
                    <%= link_to "Delete", tree_entry_path(entry),
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                        class: "px-3 py-1 bg-[#b54a3a]/80 hover:bg-[#b54a3a] text-white rounded-lg transition-colors text-xs font-semibold" %>
                  </div>
                <% else %>
                  <span class="text-[#7a8ea8]">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 border border-[#1e3a5f] rounded-2xl bg-[#152a48] p-8">
      <p class="text-[#c9bda4] text-base mb-4">No entries in this view yet.</p>
      <%= link_to "Log an entry", new_tree_entry_path, class: "px-5 py-2.5 bg-[#16a34a] hover:bg-[#15803d] text-white rounded-xl font-bold shadow transition-all" %>
    </div>
  <% end %>
</div>
