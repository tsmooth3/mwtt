<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6">Entry Details</h1>

  <div class="border border-[#1e3a5f] rounded-lg p-6 space-y-4 bg-[#152a48]">
    <div>
      <p class="text-sm text-[#9eb4d4]">Date</p>
      <p class="text-lg font-semibold"><%= @tree_entry.entry_date.strftime("%B %d, %Y") %></p>
    </div>

    <div>
      <p class="text-sm text-[#9eb4d4]">Seen</p>
      <p class="text-lg font-semibold"><%= @tree_entry.seen.nil? ? "Not reported" : @tree_entry.seen %></p>
    </div>

    <div>
      <p class="text-sm text-[#9eb4d4]">Collected</p>
      <p class="text-lg font-semibold"><%= @tree_entry.collected %></p>
    </div>

    <div>
      <p class="text-sm text-[#9eb4d4]">Season</p>
      <p class="text-lg font-semibold"><%= @tree_entry.season.year %></p>
    </div>

    <div>
      <p class="text-sm text-[#9eb4d4]">Family</p>
      <p class="text-lg font-semibold"><%= @tree_entry.family&.name || "—" %></p>
    </div>

    <div>
      <p class="text-sm text-[#9eb4d4]">Location</p>
      <p class="text-lg font-semibold"><%= @tree_entry.location&.display_name || "Not pinned" %></p>
    </div>

    <div class="flex gap-4 pt-4">
      <%= link_to "Edit", edit_tree_entry_path(@tree_entry), class: "px-4 py-2 bg-[#16a34a] text-white rounded-md hover:bg-[#15803d]" %>
      <%= link_to "Back", tree_entries_path, class: "px-4 py-2 border border-[#1e3a5f] rounded-md hover:bg-[#0f1c2e]" %>
    </div>
  </div>
</div>
